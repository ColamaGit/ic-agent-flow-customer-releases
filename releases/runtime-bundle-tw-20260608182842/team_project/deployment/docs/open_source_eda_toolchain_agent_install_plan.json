{
  "toolchain_id": "icaf_open_source_eda_validated_baseline",
  "version": "0.1",
  "description": "Machine-readable contract for customer-side AI agents to verify, install, bind, and preflight the validated EDA toolchain.",
  "tools": [
    {
      "tool_id": "verilator",
      "required": true,
      "validated_version": "v5.047",
      "minimum_supported_version": "v5.000+",
      "role": ["V1_RTL_LINT", "V2_BOUNDED_SIMULATION"],
      "version_check_commands": ["verilator --version"],
      "binding_keys": ["verilator_bin"],
      "fail_closed_if_missing": true,
      "fail_closed_if_version_below_minimum": true,
      "alternative_allowed": true,
      "requires_preflight_if_alternative": true
    },
    {
      "tool_id": "yosys",
      "required": true,
      "validated_version": "v0.64",
      "minimum_supported_version": "v0.40+",
      "role": ["H1_SYNTHESIS", "V4_LEC"],
      "version_check_commands": ["yosys -V"],
      "binding_keys": ["yosys_bin"],
      "fail_closed_if_missing": true,
      "fail_closed_if_version_below_minimum": true,
      "alternative_allowed": true,
      "requires_preflight_if_alternative": true
    },
    {
      "tool_id": "openroad",
      "required": true,
      "validated_version": "v2.0",
      "minimum_supported_version": "v2.0+",
      "role": ["H2_PLACE_AND_ROUTE", "TIMING_STA_ANALYSIS"],
      "version_check_commands": ["openroad -version"],
      "binding_keys": ["openroad_bin"],
      "fail_closed_if_missing": true,
      "fail_closed_if_version_below_minimum": true,
      "alternative_allowed": true,
      "requires_preflight_if_alternative": true
    },
    {
      "tool_id": "opensta",
      "required": true,
      "validated_version": "v2.4",
      "minimum_supported_version": "v2.0+",
      "role": ["TIMING_01_SETUP", "TIMING_02_HOLD"],
      "version_check_commands": ["sta -version", "openroad -version"],
      "binding_keys": ["opensta_bin"],
      "fail_closed_if_missing": true,
      "fail_closed_if_version_below_minimum": true,
      "alternative_allowed": true,
      "requires_preflight_if_alternative": true
    },
    {
      "tool_id": "netgen",
      "required": true,
      "validated_version": "v1.5.318",
      "minimum_supported_version": "v1.5+",
      "role": ["PHYS_03_LVS"],
      "version_check_commands": ["netgen -batch source /dev/null", "netgen -version"],
      "binding_keys": ["netgen_bin"],
      "fail_closed_if_missing": true,
      "fail_closed_if_version_below_minimum": true,
      "alternative_allowed": true,
      "requires_preflight_if_alternative": true
    },
    {
      "tool_id": "klayout",
      "required": true,
      "validated_version": "v0.29.6",
      "minimum_supported_version": "v0.26+",
      "role": ["PHYS_04_GDS_DRC"],
      "version_check_commands": ["klayout -v"],
      "binding_keys": ["klayout_python_bin"],
      "fail_closed_if_missing": true,
      "fail_closed_if_version_below_minimum": true,
      "alternative_allowed": true,
      "requires_preflight_if_alternative": true
    },
    {
      "tool_id": "symbiyosys",
      "required": true,
      "validated_version": "v0.35",
      "minimum_supported_version": "v0.30+",
      "role": ["FUNC_02_FORMAL"],
      "version_check_commands": ["sby --version"],
      "binding_keys": ["sby_bin"],
      "fail_closed_if_missing": false,
      "fail_closed_if_version_below_minimum": false,
      "alternative_allowed": true,
      "requires_preflight_if_alternative": true
    }
  ],
  "pdk": {
    "pdk_id": "sky130A",
    "required": true,
    "manager": "volare_optional",
    "binding_keys": ["sky130_root"],
    "fail_closed_if_missing": true,
    "pdk_check_commands": ["test -d \"$PDK_ROOT/sky130A\""]
  },
  "preflight": {
    "required_records": [
      "toolchain_resolution_record",
      "environment_fingerprint",
      "site_preflight_result"
    ],
    "claim_allowed_only_if": [
      "all_required_tools_resolved",
      "all_required_versions_validated",
      "smoke_tests_passed"
    ]
  }
}
