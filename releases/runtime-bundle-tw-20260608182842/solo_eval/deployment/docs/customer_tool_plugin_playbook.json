{
  "schema_version": "customer-plugin-playbook.v1",
  "name": "customer_tool_plugin_on_off_3chips",
  "mode": "strict",
  "preflight": [
    {
      "id": "schema_gate",
      "command": "./.venv/bin/python runtime/scripts/validate_schemas.py",
      "must_pass": true
    }
  ],
  "steps": [
    {
      "id": "plugin_on_run",
      "command": "ICAF_DEPLOYMENT_PROFILE=airgap-local ICAF_V116_PLUGIN_ENABLE=1 ICAF_V116_PLUGIN_STAGE=new_plugin_eda ICAF_V116_PLUGIN_INSERT_BEFORE=h4_klayout ./.venv/bin/python runtime/scripts/governance_pipeline_runner.py",
      "must_pass": true
    },
    {
      "id": "plugin_off_run",
      "command": "ICAF_DEPLOYMENT_PROFILE=airgap-local ICAF_V116_PLUGIN_ENABLE=0 ./.venv/bin/python runtime/scripts/governance_pipeline_runner.py",
      "must_pass": true
    },
    {
      "id": "real_flow_validation",
      "command": "python3 runtime/scripts/customer_tool_plugin/validate_plugin_flow_3chips.py",
      "must_pass": true,
      "must_emit": [
        "artifacts/customer-plugin-validation/plugin_flow_3chips_validation.md",
        "artifacts/customer-plugin-validation/plugin_flow_3chips_validation.json"
      ]
    }
  ],
  "completion_contract": {
    "required_json_path": "artifacts/customer-plugin-validation/plugin_flow_3chips_validation.json",
    "required_json_field": "overall_verdict",
    "required_json_value": "PASS"
  },
  "forbidden_shortcuts": [
    "simulate_folder_reindex_only_without_real_pipeline_runs",
    "claim_success_without_validation_json_pass"
  ]
}
